  "inputHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>arXiv Equation Tables</title>\n</head>\n<body>\n<article class=\"ltx_document\">\n<div class=\"ltx_page_content\">\n<div class=\"ltx_document\">\n<section class=\"ltx_section\">\n<h2 class=\"ltx_title ltx_title_section\">Scaled Dot-Product Attention</h2>\n<div class=\"ltx_para\">\n<p class=\"ltx_p\">We call the attention function on a set of queries simultaneously.</p>\n</div>\n<table class=\"ltx_equation ltx_eqn_table\">\n<tbody><tr class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_eqn_cell ltx_align_center\">\n<math alttext=\"\\mathrm{Attention}(Q,K,V)=\\mathrm{softmax}(\\frac{QK^{T}}{\\sqrt{d_{k}}})V\" class=\"ltx_Math\" display=\"block\">\n<semantics>\n<mrow><mi>Attention</mi><mo>(</mo><mi>Q</mi><mo>,</mo><mi>K</mi><mo>,</mo><mi>V</mi><mo>)</mo><mo>=</mo><mi>softmax</mi><mo>(</mo><mfrac><mrow><mi>Q</mi><msup><mi>K</mi><mi>T</mi></msup></mrow><msqrt><msub><mi>d</mi><mi>k</mi></msub></msqrt></mfrac><mo>)</mo><mi>V</mi></mrow>\n<annotation encoding=\"application/x-tex\">\\mathrm{Attention}(Q,K,V)=\\mathrm{softmax}(\\frac{QK^{T}}{\\sqrt{d_{k}}})V</annotation>\n</semantics>\n</math>\n</td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td>\n</tr></tbody>\n</table>\n<div class=\"ltx_para\">\n<p class=\"ltx_p\">The two most commonly used attention functions are additive attention and dot-product attention.</p>\n</div>\n<table class=\"ltx_equationgroup ltx_eqn_table\">\n<tbody>\n<tr class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_td ltx_align_right\">\n<math alttext=\"\\mathrm{MultiHead}(Q,K,V)=\\mathrm{Concat}(\\mathrm{head}_{1},...,\\mathrm{head}_{h})W^{O}\" class=\"ltx_Math\" display=\"inline\">\n<semantics>\n<mrow><mi>MultiHead</mi><mo>(</mo><mi>Q</mi><mo>,</mo><mi>K</mi><mo>,</mo><mi>V</mi><mo>)</mo><mo>=</mo><mi>Concat</mi><mo>(</mo><msub><mi>head</mi><mn>1</mn></msub><mo>,</mo><mo>...</mo><mo>,</mo><msub><mi>head</mi><mi>h</mi></msub><mo>)</mo><msup><mi>W</mi><mi>O</mi></msup></mrow>\n<annotation encoding=\"application/x-tex\">\\mathrm{MultiHead}(Q,K,V)=\\mathrm{Concat}(\\mathrm{head}_{1},...,\\mathrm{head}_{h})W^{O}</annotation>\n</semantics>\n</math>\n</td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td>\n</tr>\n</tbody>\n</table>\n</section>\n</div>\n</div>\n</article>\n</body>\n</html>\n",
