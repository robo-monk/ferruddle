      "kind": "element",
      "name": "p",
      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "The attention mechanism computes $$h_{i}^{\\ell+1} = \\text{Attention} \\left( Q^{\\ell} h_{i}^{\\ell}, K^{\\ell} h_{j}^{\\ell}, V^{\\ell} h_{j}^{\\ell} \\right)$$ for each node in the graph."
        }
      ]
    },
    {
      "kind": "element",
      "name": "p",
      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "Here $f(x) = \\sum_{i=0}^{n} \\frac{a_i}{i!} x^i$ is the Taylor expansion and $g(x) = \\int_0^1 e^{-t^2} dt$ is the Gaussian integral."
        }
      ]
    },
    {
      "kind": "element",
      "name": "p",
      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "The loss function is defined as:"
        }
      ]
    },
    {
      "kind": "element",
      "name": "p",
      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "$$\\mathcal{L}(\\theta) = -\\frac{1}{N} \\sum_{i=1}^{N} \\log p_\\theta(x_i)$$"
        }
      ]
    },
    {
      "kind": "element",
      "name": "p",
      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "This costs $100 per unit, which is not math."
        }
      ]
    },
    {
      "kind": "element",
      "name": "p",
      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "Let $x$ be a variable and $n$ be an integer."
        }
      ]
    },
    {
      "kind": "element",
      "name": "p",
      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "The backslash delimiters work too: \\(E = mc^2\\) is inline and"
        }
      ]
    },
    {
      "kind": "element",
      "name": "p",
      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "\\[F = ma\\]"
        }
      ]
    },
    {
      "kind": "code",
      "block": true,
      "language": "",
      "text": "This $\\alpha$ should not be touched inside pre tags."
    }
  ],
