      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "Early "
        },
        {
          "kind": "element",
          "name": "a",
          "attributes": [
            [
              "href",
              "https://encyclopedia.example.com/wiki/Apparatus"
            ]
          ],
          "children": [
            {
              "kind": "text",
              "text": "apparatus"
            }
          ]
        },
        {
          "kind": "text",
          "text": " used in the first surveys"
        }
      ]
    },
    {
      "kind": "element",
      "name": "a",
      "attributes": [
        [
          "href",
          "https://encyclopedia.example.com/wiki/File:Field_site.jpg"
        ]
      ],
      "children": [
        {
          "kind": "element",
