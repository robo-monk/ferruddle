                ]
              ],
              "children": [
                {
                  "kind": "text",
                  "text": "2"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "element",
      "name": "p",
      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "The new faction introduced in episode three was a welcome addition to the lore."
        },
        {
          "kind": "anchor",
          "id": "fnref:3"
        },
        {
          "kind": "element",
          "name": "sup",
          "attributes": [],
          "children": [
            {
              "kind": "element",
              "name": "a",
              "attributes": [
                [
                  "href",
                  "#fn:3"
                ]
              ],
              "children": [
                {
                  "kind": "text",
                  "text": "3"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "element",
      "name": "ol",
      "attributes": [],
      "children": [
        {
          "kind": "anchor",
          "id": "fn:1"
        },
        {
          "kind": "element",
          "name": "li",
          "attributes": [],
          "children": [
            {
              "kind": "text",
              "text": "By my count: 1) Alice and Bob. 2) Bob's backstory. 3) Charlie and the team. 4) Drama at headquarters. 5) Diana and the organization. 6) Eve and her scheming."
            },
            {
              "kind": "element",
              "name": "a",
              "attributes": [
                [
                  "href",
                  "#fnref:1"
                ],
                [
                  "title",
                  "return to article"
                ]
              ],
              "children": [
                {
                  "kind": "text",
                  "text": "↩"
                }
              ]
            }
          ]
        },
        {
          "kind": "anchor",
          "id": "fn:2"
        },
        {
          "kind": "element",
          "name": "li",
          "attributes": [],
          "children": [
            {
              "kind": "text",
              "text": "It took me a while to understand that by \"the district,\" they meant "
            },
            {
              "kind": "element",
              "name": "a",
              "attributes": [
                [
                  "href",
                  "https://example.com/wiki/The_Leader"
                ]
              ],
              "children": [
                {
                  "kind": "text",
                  "text": "the Leader's"
                }
              ]
            },
            {
              "kind": "text",
              "text": " chapter."
            },
            {
              "kind": "element",
              "name": "a",
              "attributes": [
                [
                  "href",
                  "#fnref:2"
                ],
                [
                  "title",
                  "return to article"
                ]
              ],
              "children": [
                {
                  "kind": "text",
                  "text": "↩"
                }
              ]
            }
          ]
        },
        {
          "kind": "anchor",
          "id": "fn:3"
        },
        {
          "kind": "element",
          "name": "li",
          "attributes": [],
          "children": [
            {
              "kind": "text",
              "text": "I'm glad to see the old guard back, but I'm skeptical they've been camped out this whole time."
            },
            {
              "kind": "element",
              "name": "a",
              "attributes": [
                [
                  "href",
                  "#fnref:3"
                ],
                [
