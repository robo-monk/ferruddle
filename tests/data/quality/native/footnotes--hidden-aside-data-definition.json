                }
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "element",
      "name": "p",
      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "For the second installment, the writers stuck much closer to what was established in the source material, mostly the second entry, but with a smattering of references from the other entries."
        },
        {
          "kind": "anchor",
          "id": "fnref:2"
        },
        {
          "kind": "element",
          "name": "sup",
          "attributes": [],
