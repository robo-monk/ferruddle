+/// A selector list that evaluates only selectors whose rightmost compound can
+/// apply to an element's tag, id, classes, or attribute names. Each candidate
+/// is still verified by its full matcher, so results equal the joined list.
+pub struct SelectorIndex {
+    matchers: Vec<Matcher>,
+    always: Vec<usize>,
+    tags: HashMap<String, Vec<usize>>,
+    classes: HashMap<String, Vec<usize>>,
+    ids: HashMap<String, Vec<usize>>,
+    attrs: HashMap<String, Vec<usize>>,
+}
+
+impl SelectorIndex {
+    pub fn new(selectors: &[&str]) -> Self {
+        let mut index = SelectorIndex {
+            matchers: Vec::new(),
+            always: Vec::new(),
+            tags: HashMap::new(),
+            classes: HashMap::new(),
+            ids: HashMap::new(),
+            attrs: HashMap::new(),
+        };
+        for selector in selectors {
+            let Ok(matcher) = Matcher::new(selector) else {
+                continue;
+            };
+            let position = index.matchers.len();
+            index.matchers.push(matcher);
+            let bucket = match rightmost_key(selector) {
+                Some((b'.', name)) => index.classes.entry(name),
+                Some((b'#', name)) => index.ids.entry(name),
+                Some((b'[', name)) => index.attrs.entry(name.to_ascii_lowercase()),
+                Some((_, name)) => index.tags.entry(name.to_ascii_lowercase()),
+                None => {
+                    index.always.push(position);
+                    continue;
+                }
+            };
+            bucket.or_default().push(position);
+        }
+        index
+    }
+
+    pub fn matches(&self, node: NodeRef<'_>) -> bool {
+        let mut candidates = self.always.clone();
+        node.query(|data| {
+            let NodeData::Element(element) = &data.data else {
+                return;
+            };
+            let local = element.name.local.to_ascii_lowercase();
+            candidates.extend(self.tags.get(&*local).into_iter().flatten());
+            for attr in &element.attrs {
+                let name = attr.name.local.to_ascii_lowercase();
+                candidates.extend(self.attrs.get(&*name).into_iter().flatten());
+                match &*name {
+                    "id" => candidates.extend(self.ids.get(attr.value.as_ref()).into_iter().flatten()),
+                    "class" => {
+                        for class in attr.value.split_ascii_whitespace() {
+                            candidates.extend(self.classes.get(class).into_iter().flatten());
+                        }
+                    }
+                    _ => (),
+                }
+            }
+        });
+        candidates.iter().any(|&i| node.is_match(&self.matchers[i]))
+    }
+
+    /// Matching descendants in document order, like [`select`].
+    pub fn select<'a>(&self, root: NodeRef<'a>) -> Vec<NodeRef<'a>> {
+        root.descendants_it()
+            .filter(|node| node.is_element() && self.matches(*node))
+            .collect()
+    }
+}
+
+/// The first simple selector of the rightmost compound, when it is a plain
+/// type, class, id, or attribute-name test that every match must satisfy.
+fn rightmost_key(selector: &str) -> Option<(u8, String)> {
+    let (mut depth, mut quote, mut start) = (0i32, None, 0);
+    for (i, byte) in selector.bytes().enumerate() {
+        match (quote, byte) {
+            (Some(q), b) if b == q => quote = None,
+            (Some(_), _) => (),
+            (None, b'"' | b'\'') => quote = Some(byte),
+            (None, b'[' | b'(') => depth += 1,
+            (None, b']' | b')') => depth -= 1,
+            (None, b',') if depth == 0 => return None,
+            (None, b' ' | b'>' | b'+' | b'~') if depth == 0 => start = i + 1,
+            _ => (),
+        }
+    }
+    let compound = selector[start..].trim();
+    let first = *compound.as_bytes().first()?;
+    let rest = match first {
+        b'.' | b'#' | b'[' => &compound[1..],
+        b if b.is_ascii_alphabetic() => compound,
+        _ => return None,
+    };
+    let name: String = rest
+        .chars()
+        .take_while(|c| c.is_ascii_alphanumeric() || matches!(c, '-' | '_'))
+        .collect();
+    let end = rest.as_bytes().get(name.len()).copied();
+    // Escapes or unusual characters make the key unreliable; check always.
+    if name.is_empty() || matches!(end, Some(b'\\' | b'|')) {
+        return None;
+    }
+    Some((if first.is_ascii_alphabetic() { b't' } else { first }, name))
+}
+
+/// Whether any descendant matches, stopping at the first match.
+pub fn exists(root: NodeRef<'_>, selector: &str) -> bool {
+    matcher(selector).is_some_and(|matcher| {
+        root.descendants_it()
+            .any(|node| node.is_element() && node.is_match(&matcher))
+    })
+}
