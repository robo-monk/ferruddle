+/// Whether a node's text (`node.text()`) has at most `limit` words, stopping
+/// once the limit is exceeded instead of materializing the subtree text.
+pub fn words_at_most(node: dom_query::NodeRef<'_>, limit: usize) -> bool {
+    let mut count = 0;
+    let mut in_word = false;
+    for current in std::iter::once(node).chain(node.descendants_it()) {
+        let exceeded = current.query_or(false, |n| {
+            let dom_query::NodeData::Text { contents } = &n.data else {
+                return false;
+            };
+            for ch in contents.chars() {
+                let cjk = matches!(ch as u32,
+                    0x3040..=0x309f | 0x30a0..=0x30ff | 0x3400..=0x4dbf |
+                    0x4e00..=0x9fff | 0xf900..=0xfaff | 0xac00..=0xd7af);
+                if cjk {
+                    count += 1;
+                    in_word = false;
+                } else if ch <= ' ' {
+                    in_word = false;
+                } else if !in_word {
+                    count += 1;
+                    in_word = true;
+                }
+                if count > limit {
+                    return true;
+                }
+            }
+            false
+        });
+        if exceeded {
+            return false;
+        }
+    }
+    true
+}
