                }
              ]
            }
          ]
        },
        {
          "kind": "anchor",
          "id": "fn:2"
        },
        {
          "kind": "element",
          "name": "li",
          "attributes": [],
          "children": [
            {
              "kind": "text",
              "text": "An exception is when calling certain interop methods, discussed in a later chapter."
            },
            {
              "kind": "element",
              "name": "a",
              "attributes": [
                [
                  "href",
                  "#fnref:2"
