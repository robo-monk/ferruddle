{
  "html": [
    {
      "kind": "element",
      "name": "p",
      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "We call these energy differences "
        },
        {
          "kind": "element",
          "name": "script",
          "attributes": [],
          "children": [
            {
              "kind": "text",
              "text": "E_u"
            }
          ]
        },
        {
          "kind": "text",
          "text": " and "
        },
        {
          "kind": "element",
          "name": "script",
          "attributes": [],
          "children": [
            {
              "kind": "text",
              "text": "E_l"
            }
          ]
        },
        {
          "kind": "text",
          "text": " (subscripts refer to \"upper\" and \"lower\"), or in units of frequency, "
        },
        {
          "kind": "element",
          "name": "script",
          "attributes": [],
          "children": [
            {
              "kind": "text",
              "text": "f_u"
            }
          ]
        },
        {
          "kind": "text",
          "text": " and "
        },
        {
          "kind": "element",
          "name": "script",
          "attributes": [],
          "children": [
            {
              "kind": "text",
              "text": "f_l"
            }
          ]
        },
        {
          "kind": "text",
          "text": " (where "
        },
        {
          "kind": "element",
          "name": "script",
          "attributes": [],
          "children": [
            {
              "kind": "text",
              "text": "E_{l,u} = hf_{l,u}"
            }
          ]
        },
        {
          "kind": "text",
          "text": ")."
        }
      ]
    },
    {
      "kind": "element",
      "name": "p",
      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "As a special case, when "
        },
        {
          "kind": "element",
          "name": "script",
          "attributes": [],
          "children": [
            {
              "kind": "text",
              "text": "\\mathbf{B}"
            }
          ]
        },
        {
          "kind": "text",
          "text": " is aligned with the NV axis (i.e., "
        },
        {
          "kind": "element",
          "name": "script",
          "attributes": [],
          "children": [
            {
              "kind": "text",
              "text": "\\theta = 0"
            }
          ]
        },
        {
          "kind": "text",
          "text": "), the above relation reduces to:"
        }
      ]
    },
    {
      "kind": "element",
      "name": "script",
      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "f_u = D+\\gamma B \\quad \\text{and} \\quad f_l = D-\\gamma B."
        }
      ]
    },
    {
      "kind": "element",
      "name": "p",
      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "The key result is:"
        }
      ]
    },
    {
      "kind": "element",
      "name": "script",
      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "B= \\frac{1}{\\sqrt{3}\\gamma}\\sqrt{f_u^2+f_l^2-f_u f_l-D^2}"
        }
      ]
    },
    {
      "kind": "element",
      "name": "p",
      "attributes": [],
      "children": [
        {
          "kind": "text",
          "text": "Here, "
        },
        {
          "kind": "element",
          "name": "script",
          "attributes": [],
          "children": [
            {
              "kind": "text",
              "text": "\\gamma = 28"
            }
          ]
        },
        {
          "kind": "text",
          "text": " GHz/T is the gyromagnetic ratio."
        }
      ]
    }
  ],
