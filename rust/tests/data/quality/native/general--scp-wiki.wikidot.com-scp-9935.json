            {
              "kind": "element",
              "name": "em",
              "attributes": [],
              "children": [
                {
                  "kind": "text",
                  "text": "\"Me and John went out to speak with Bill about stoppin' things, for we were all bone-tired, but he just shook his head and said the game had to be played out, no matter the hour.\""
                }
              ]
            }
          ]
        }
      ]
