  "inputHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\"/>\n  <title>Figure Content Wrapper Test</title>\n</head>\n<body>\n  <!--\n    Reproduces the Medium-embedded-in-WordPress pattern where the entire\n    article body is wrapped in a <figure> element. The figure rule must\n    not treat this as an image figure and discard all the text.\n  -->\n  <article class=\"post\">\n    <div class=\"article-header\">\n      <h1>Example Article Title</h1>\n    </div>\n    <div class=\"article-body\">\n      <!-- Outer figure wraps entire article body (Medium layout) -->\n      <figure class=\"paragraph-image\">\n        <div class=\"content-wrapper\">\n          <p>First paragraph with some content about the topic.</p>\n          <p>Second paragraph continuing the discussion.</p>\n\n          <!-- Individual image figure nested inside the outer figure -->\n          <figure class=\"inline-image\">\n            <img src=\"https://example.com/diagram.png\" alt=\"A diagram\" width=\"640\" height=\"400\"/>\n          </figure>\n\n          <p>Third paragraph after the image.</p>\n          <p>Fourth paragraph wrapping up the section.</p>\n        </div>\n      </figure>\n    </div>\n    <div class=\"author-bio\">\n      <p>Author Name</p>\n      <p>Author bio goes here.</p>\n    </div>\n  </article>\n</body>\n</html>\n",
